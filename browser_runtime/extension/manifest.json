{
  "manifest_version": 3,
  "name": "HKU AGENTS Portal/SIS Bridge",
  "version": "0.4.4",
  "description": "Restricted local navigation and read-only inspection bridge for HKU Portal and SIS.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [
    "https://hkuportal.hku.hk/*",
    "https://studentportal.hku.hk/*",
    "https://sis-main.hku.hk/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "HKU AGENTS SIS Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://sis-main.hku.hk/*"],
      "js": ["sis_parser.js", "navigation.js", "content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://hkuportal.hku.hk/*",
        "https://studentportal.hku.hk/*"
      ],
      "js": ["navigation.js", "portal_content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
