LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
# Put your DeepSeek API key after the equals sign.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Backup model. Leave the key empty to disable the fallback at runtime.
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-2.5-flash
# Put your Gemini API key after the equals sign if you want backup enabled.
GEMINI_API_KEY=

QUERY_REWRITE_PROVIDER=deepseek
QUERY_REWRITE_MODEL=deepseek-chat

DENSE_MODEL=BAAI/bge-m3
SPARSE_MODEL=Qdrant/bm25
# Persistent local cache; avoids relying on the Windows temporary directory.
FASTEMBED_CACHE_PATH=.cache/fastembed
SEARCH_SCORE_THRESHOLD=0.3
CHILD_COLLECTION=document_child_chunks_bge_m3
DIRECT_SINGLE_QUESTION=true
DIRECT_RETRIEVAL_LIMIT=5
DIRECT_RETRIEVAL_RETRIES=4
MAX_TOOL_CALLS=5
MAX_ITERATIONS=4

# Local-first application server and task/audit database.
APP_HOST=127.0.0.1
APP_PORT=7860
API_BASE_URL=http://127.0.0.1:7860
APP_DB_PATH=hku_agents.db
CONFIRMATION_TTL_SECONDS=300
# Shared only with trusted local GUI/agent-host adapters. Use at least 32 random
# characters. If blank, HKU AGENTS creates a process-local token shown in the GUI.
INTEGRATION_API_TOKEN=

# Read-only local browser bridge. Leave IDs empty during development to pin the
# first extension that presents the current pairing token. Production builds
# should list the signed Chrome extension ID explicitly.
BROWSER_BRIDGE_ENABLED=true
BROWSER_HEARTBEAT_TIMEOUT_SECONDS=45
BROWSER_COMMAND_TIMEOUT_SECONDS=35
# Recommended for stable local development: generate at least 32 random
# characters once, store them only in this ignored .env file, and paste the
# same token into the extension once. If blank, a new token is generated on
# every HKU AGENTS process start.
BROWSER_PAIRING_TOKEN=
BROWSER_EXTENSION_IDS=

# Optional local provider.
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b-instruct
# OLLAMA_BASE_URL=http://localhost:11434

# For local development, this can move query rewriting off Gemini while keeping
# final answers on DeepSeek:
# QUERY_REWRITE_PROVIDER=ollama
# QUERY_REWRITE_MODEL=qwen2.5:3b-instruct

# Optional OCR fallback for scanned PDFs. Requires local Tesseract data.
# ENABLE_PDF_OCR=false
# PDF_OCR_LANGUAGE=chi_sim+eng
